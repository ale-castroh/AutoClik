<Window x:Class="Autoclicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autoclicker"
        Width="380" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding IsChecked, ElementName=PinButton}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Menú del icono de la bandeja -->
        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="Iniciar" Icon="&#xE768;" Click="TrayStart_Click" />
            <MenuItem Header="Mostrar ventana" Icon="&#xE8A7;" Click="TrayShow_Click" />
            <Separator />
            <MenuItem Header="Salir" Icon="&#xE7E8;" Click="TrayExit_Click" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Barra de título ================= -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border Width="18" Height="18" CornerRadius="5" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="&#xE8B0;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource OnAccentBrush}" />
                </Border>
                <!-- Perfil actual: clic para cambiar, crear, renombrar o eliminar -->
                <Button x:Name="ProfileButton" Margin="6,0,0,0" Width="NaN" Padding="6,0" MaxWidth="150"
                        Style="{StaticResource TitleBarButtonStyle}" FontFamily="{StaticResource UiFont}" FontSize="12"
                        ToolTip="Perfiles" Click="ProfileButton_Click">
                    <StackPanel Orientation="Horizontal" Margin="6,0">
                        <TextBlock x:Name="ProfileNameText" Text="Predeterminado" TextTrimming="CharacterEllipsis"
                                   MaxWidth="110" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                   Margin="6,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                <ToggleButton x:Name="SettingsButton" Content="&#xE713;" FontSize="13" ToolTip="Ajustes"
                              Style="{StaticResource TitleBarToggleStyle}"
                              Checked="SettingsButton_Changed" Unchecked="SettingsButton_Changed" />
                <ToggleButton x:Name="PinButton" Style="{StaticResource TitleBarPinStyle}" />
                <Button Content="&#xE921;" ToolTip="Minimizar" Style="{StaticResource TitleBarButtonStyle}"
                        Click="Minimize_Click" />
                <Button Content="&#xE8BB;" ToolTip="Cerrar" Style="{StaticResource TitleBarCloseButtonStyle}"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- Dos páginas en la misma celda; solo una visible. La ventana se ajusta a su alto. -->
        <Grid Grid.Row="1">

            <!-- ================= Página principal ================= -->
            <StackPanel x:Name="MainPage" Margin="16,0,16,16">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>

                <!-- Botón + contador -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,22">
                    <ToggleButton x:Name="StartButton" Width="108" Height="108"
                                  Style="{StaticResource StartButtonStyle}"
                                  Checked="StartButton_Checked" Unchecked="StartButton_Unchecked" />

                    <StackPanel Margin="34,0,0,0" VerticalAlignment="Center" MinWidth="130">
                        <TextBlock x:Name="CountText" Text="0" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="38" FontWeight="SemiBold" />
                        <TextBlock x:Name="RateText" Text="clics · 0,0/s" Margin="1,-2,0,0"
                                   Style="{StaticResource CaptionStyle}" />

                        <Border HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,4" CornerRadius="11"
                                Background="{DynamicResource SubtleHoverBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=StartButton}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock x:Name="StatusText" Text="Detenido" Margin="7,0,0,0" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="HotkeyHintText" Text="F6 para iniciar" Margin="2,7,0,0"
                                   Style="{StaticResource CaptionStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Opciones esenciales -->
                <Border x:Name="OptionsCard" Style="{StaticResource ListCardStyle}">
                    <StackPanel>
                        <!-- Intervalo -->
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="4">
                                    <RadioButton x:Name="UnitMsRadio" Content="ms" GroupName="Unit" IsChecked="True" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="UnitSRadio" Content="s" GroupName="Unit" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="UnitMinRadio" Content="min" GroupName="Unit" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="UnitHRadio" Content="h" GroupName="Unit" Style="{StaticResource CompactSegmentStyle}" />
                                </UniformGrid>
                            </Border>
                            <TextBox x:Name="IntervalBox" DockPanel.Dock="Right" Text="100" MaxLength="6" Width="68"
                                     Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="Intervalo" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>

                        <Border Style="{StaticResource ListDividerStyle}" />

                        <!-- Botón -->
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="LeftButtonRadio" Content="Izquierdo" GroupName="MouseButton" IsChecked="True" Style="{StaticResource SegmentStyle}" />
                                    <RadioButton x:Name="RightButtonRadio" Content="Derecho" GroupName="MouseButton" Style="{StaticResource SegmentStyle}" />
                                    <RadioButton x:Name="MiddleButtonRadio" Content="Central" GroupName="MouseButton" Style="{StaticResource SegmentStyle}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="Botón" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>

                        <Border Style="{StaticResource ListDividerStyle}" />

                        <!-- Tipo -->
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="SingleKindRadio" Content="Simple" GroupName="ClickKind" IsChecked="True" Style="{StaticResource SegmentStyle}" />
                                    <RadioButton x:Name="DoubleKindRadio" Content="Doble" GroupName="ClickKind" Style="{StaticResource SegmentStyle}" />
                                    <RadioButton x:Name="HoldKindRadio" Content="Mantener" GroupName="ClickKind" Style="{StaticResource SegmentStyle}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="Tipo" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource DetailRowStyle}"
                                   Visibility="{Binding IsChecked, ElementName=HoldKindRadio, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" Text="ms" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="HoldBox" DockPanel.Dock="Right" Text="100" MaxLength="6" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="Mantener pulsado durante" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Style="{StaticResource ListDividerStyle}" />

                        <!-- Repetir -->
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="RepeatForeverRadio" Content="Sin fin" GroupName="Repeat" IsChecked="True" Style="{StaticResource SegmentStyle}" />
                                    <RadioButton x:Name="RepeatCountRadio" Content="Veces" GroupName="Repeat" Style="{StaticResource SegmentStyle}" />
                                    <RadioButton x:Name="RepeatTimeRadio" Content="Tiempo" GroupName="Repeat" Style="{StaticResource SegmentStyle}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="Repetir" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource DetailRowStyle}"
                                   Visibility="{Binding IsChecked, ElementName=RepeatCountRadio, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="RepeatUnitText" DockPanel.Dock="Right" Text="clics" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="RepeatCountBox" DockPanel.Dock="Right" Text="100" MaxLength="9" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="Parar después de" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource DetailRowStyle}"
                                   Visibility="{Binding IsChecked, ElementName=RepeatTimeRadio, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" Text="s" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="DurationBox" DockPanel.Dock="Right" Text="60" MaxLength="6" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="Clicar durante" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Style="{StaticResource ListDividerStyle}" />

                        <!-- Posición -->
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="CursorPositionRadio" Content="Cursor" GroupName="Position" IsChecked="True" Style="{StaticResource SegmentStyle}"
                                                 ToolTip="Clica donde esté el cursor" />
                                    <RadioButton x:Name="FixedPositionRadio" Content="Fijo" GroupName="Position" Style="{StaticResource SegmentStyle}"
                                                 ToolTip="Clica siempre en el mismo punto" />
                                    <RadioButton x:Name="PointsPositionRadio" Content="Puntos" GroupName="Position" Style="{StaticResource SegmentStyle}"
                                                 Checked="PointsMode_Changed" Unchecked="PointsMode_Changed"
                                                 ToolTip="Recorre varios puntos marcados en la pantalla" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="Posición" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource DetailRowStyle}"
                                   Visibility="{Binding IsChecked, ElementName=FixedPositionRadio, Converter={StaticResource BoolToVis}}">
                            <Button x:Name="PickButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="PickPosition_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" ToolTip="Elegir el punto en la pantalla">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B0;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Elegir" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="YBox" DockPanel.Dock="Right" Text="0" MaxLength="6" Width="62" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock DockPanel.Dock="Right" Text="Y" Margin="10,0,6,0" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                            <TextBox x:Name="XBox" DockPanel.Dock="Right" Text="0" MaxLength="6" Width="62" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock DockPanel.Dock="Right" Text="X" Margin="0,0,6,0" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                            <TextBlock />
                        </DockPanel>
                        <StackPanel Visibility="{Binding IsChecked, ElementName=PointsPositionRadio, Converter={StaticResource BoolToVis}}">
                            <DockPanel Style="{StaticResource DetailRowStyle}">
                                <Button x:Name="AddPointsButton" DockPanel.Dock="Right" Margin="6,0,0,0" Click="AddPoints_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" ToolTip="Haz clic en la pantalla para colocar puntos">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="Añadir" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RecordButton" DockPanel.Dock="Right" Margin="6,0,0,0" Click="RecordPoints_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Graba tus clics (posición, botón y tiempos) y los convierte en puntos">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#E5484D" VerticalAlignment="Center" />
                                        <TextBlock Text="Grabar" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ClearPointsButton" DockPanel.Dock="Right" Click="ClearPoints_Click" Padding="9,0" IsEnabled="False"
                                        Style="{StaticResource SecondaryButtonStyle}" ToolTip="Quitar todos los puntos">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                </Button>
                                <TextBlock x:Name="PointsSummaryText" Text="Sin puntos" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" Style="{StaticResource CaptionStyle}"
                                           ToolTip="Clic en un marcador para editarlo; arrástralo para moverlo" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource DetailRowStyle}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentedContainerStyle}">
                                    <UniformGrid Columns="4">
                                        <RadioButton x:Name="SpeedHalfRadio" Content="×0,5" GroupName="Speed" Style="{StaticResource CompactSegmentStyle}" />
                                        <RadioButton x:Name="Speed1Radio" Content="×1" GroupName="Speed" IsChecked="True" Style="{StaticResource CompactSegmentStyle}" />
                                        <RadioButton x:Name="Speed2Radio" Content="×2" GroupName="Speed" Style="{StaticResource CompactSegmentStyle}" />
                                        <RadioButton x:Name="Speed4Radio" Content="×4" GroupName="Speed" Style="{StaticResource CompactSegmentStyle}" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock Text="Velocidad" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                           ToolTip="Reproduce la secuencia más lenta o más rápida (esperas y pulsaciones)" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= Página de ajustes ================= -->
            <StackPanel x:Name="SettingsPage" Margin="16,0,16,16" Visibility="Collapsed">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>

                <TextBlock Text="Ajustes" Margin="4,0,0,0" FontFamily="{StaticResource DisplayFont}"
                           FontSize="20" FontWeight="SemiBold" />

                <!-- Atajo -->
                <TextBlock Text="Atajo" Style="{StaticResource GroupLabelStyle}" />
                <Border x:Name="HotkeyCard" Style="{StaticResource ListCardStyle}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource ListRowStyle}" MinHeight="56">
                            <ToggleButton x:Name="HotkeyButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Content="F6" Style="{StaticResource KeyCapStyle}"
                                          Checked="HotkeyButton_Checked" Unchecked="HotkeyButton_Unchecked" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Iniciar / detener" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock x:Name="HotkeyNoteText" Text="Funciona aunque la ventana esté oculta"
                                           Style="{StaticResource RowHintStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="ToggleModeRadio" Content="Alternar" GroupName="HotkeyMode" IsChecked="True" Style="{StaticResource SegmentStyle}"
                                                 ToolTip="Pulsa una vez para empezar y otra para parar" />
                                    <RadioButton x:Name="HoldModeRadio" Content="Mantener" GroupName="HotkeyMode" Style="{StaticResource SegmentStyle}"
                                                 ToolTip="Clica solo mientras mantienes pulsado el atajo" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="Modo" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Clics -->
                <TextBlock Text="Clics" Style="{StaticResource GroupLabelStyle}" />
                <Border x:Name="ClicksCard" Style="{StaticResource ListCardStyle}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <TextBlock DockPanel.Dock="Right" Text="± %" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="JitterBox" DockPanel.Dock="Right" Text="0" MaxLength="2" VerticalAlignment="Center" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="Variación del intervalo" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="Ritmo irregular, más natural" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <TextBlock DockPanel.Dock="Right" Text="± px" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="OffsetBox" DockPanel.Dock="Right" Text="0" MaxLength="4" VerticalAlignment="Center" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="Desvío del punto fijo" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="Clica alrededor del punto fijo, no siempre en el mismo píxel" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <TextBlock DockPanel.Dock="Right" Text="s" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="DelayBox" DockPanel.Dock="Right" Text="0" MaxLength="3" VerticalAlignment="Center" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="Retardo de inicio" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="Cuenta atrás antes del primer clic" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <CheckBox x:Name="LockWindowSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}" />
                            <TextBlock Text="Pausar si cambia la ventana activa" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="Clica solo en la ventana que estaba activa al empezar; si cambias a otra, se pausa y sigue al volver" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource GroupLabelStyle}" />
                <Border Style="{StaticResource ListCardStyle}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <CheckBox x:Name="EmergencySwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      IsChecked="True" Style="{StaticResource ToggleSwitchStyle}" />
                            <TextBlock Text="Parar al llevar el ratón a una esquina" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="Parada de emergencia: mueve el ratón a cualquier esquina de la pantalla" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <CheckBox x:Name="MinimizeToTraySwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      IsChecked="True" Style="{StaticResource ToggleSwitchStyle}" />
                            <TextBlock Text="Minimizar a la bandeja" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <CheckBox x:Name="CloseToTraySwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}" />
                            <TextBlock Text="Cerrar a la bandeja" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="La X oculta la ventana; para salir, usa el menú del icono" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
