<Window x:Class="Autoclicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Autoclicker.Localization"
        xmlns:t="clr-namespace:Autoclicker.Theme"
        Title="AutoClik"
        Width="440" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding IsChecked, ElementName=PinButton}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Menú del icono de la bandeja -->
        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="{l:T TrayStart}" Icon="&#xE768;" Click="TrayStart_Click" />
            <MenuItem Header="{l:T TrayShow}" Icon="&#xE8A7;" Click="TrayShow_Click" />
            <Separator />
            <MenuItem Header="{l:T TrayExit}" Icon="&#xE7E8;" Click="TrayExit_Click" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Barra de título ================= -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <!-- Logo (sin fondo): el lienzo de 24 se escala entero, así nada se descentra -->
                <Viewbox Width="26" Height="26" Margin="-3,0,0,0">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource LogoBodyGeometry}" Fill="White" Stroke="{StaticResource LogoInkBrush}"
                              StrokeThickness="1.4" />
                        <Path Data="{StaticResource LogoLinesGeometry}" Stroke="{StaticResource LogoInkBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="{StaticResource LogoSparkGeometry}" Stroke="{StaticResource LogoSparkBrush}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <!-- Perfil actual: clic para cambiar, crear, renombrar o eliminar -->
                <Button x:Name="ProfileButton" Margin="6,0,0,0" Width="NaN" Padding="6,0" MaxWidth="150"
                        Style="{StaticResource TitleBarButtonStyle}" FontFamily="{StaticResource UiFont}" FontSize="12"
                        ToolTip="{l:T Profiles}" Click="ProfileButton_Click">
                    <StackPanel Orientation="Horizontal" Margin="6,0">
                        <TextBlock x:Name="ProfileNameText" Text="{l:T DefaultProfile}" TextTrimming="CharacterEllipsis"
                                   MaxWidth="110" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                   Margin="6,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                <ToggleButton x:Name="PinButton" Style="{StaticResource TitleBarPinStyle}" />
                <Button Content="&#xE921;" ToolTip="{l:T Minimize}" Style="{StaticResource TitleBarButtonStyle}"
                        Click="Minimize_Click" />
                <Button Content="&#xE8BB;" ToolTip="{l:T Close}" Style="{StaticResource TitleBarCloseButtonStyle}"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- ================= Barra lateral + secciones ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Un botón por sección; Ajustes siempre abajo. El puntito verde = funcionando. -->
            <DockPanel Grid.Column="0" Margin="14,2,0,14">
                <ToggleButton x:Name="SettingsButton" DockPanel.Dock="Bottom" Content="&#xE713;" ToolTip="{l:T Settings}"
                              Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Unchecked="Nav_Unchecked" />
                <StackPanel>
                    <ToggleButton x:Name="NavClicksButton" Content="&#xE8B0;" ToolTip="{l:T NavClicks}" IsChecked="True"
                                  Tag="{Binding IsChecked, ElementName=StartButton}"
                                  Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Unchecked="Nav_Unchecked" />
                    <ToggleButton x:Name="NavMacrosButton" Content="&#xE7C8;" ToolTip="{l:T Macros}"
                                  Tag="{Binding IsChecked, ElementName=PlayMacroButton}"
                                  Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Unchecked="Nav_Unchecked" />
                    <ToggleButton x:Name="NavAntiAfkButton" Content="&#xE823;" ToolTip="{l:T AntiAfk}"
                                  Tag="{Binding IsChecked, ElementName=AntiAfkSwitch}"
                                  Visibility="{Binding IsChecked, ElementName=ExperimentalSwitch, Converter={StaticResource BoolToVis}}"
                                  Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Unchecked="Nav_Unchecked" />
                </StackPanel>
            </DockPanel>

            <!-- Las secciones comparten celda; solo una visible. La ventana se ajusta a su alto. -->
            <Grid Grid.Column="1">

            <!-- ================= Página principal ================= -->
            <StackPanel x:Name="MainPage" Margin="12,0,16,16">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>

                <!-- Lectura: estado, contador y botón principal -->
                <StackPanel Margin="2,6,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource IdleDotBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=StartButton}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock x:Name="StatusText" Text="{l:T Stopped}" Margin="7,0,0,0" FontSize="12" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=StartButton}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock x:Name="CountText" Text="0" Margin="-2,6,0,0" FontFamily="{StaticResource NumberFont}"
                               FontSize="52" LineStackingStrategy="BlockLineHeight" LineHeight="48" />
                    <TextBlock x:Name="RateText" Text="" Style="{StaticResource CaptionStyle}" />

                    <ToggleButton x:Name="StartButton" Margin="0,16,0,0" Style="{StaticResource PrimaryToggleStyle}"
                                  Content="{l:T StartBtn}" t:Ui.CheckedText="{l:T StopBtn}" t:Ui.KeyText="F6"
                                  Checked="StartButton_Checked" Unchecked="StartButton_Unchecked" />
                    <!-- Solo en modo "Mantener" (p. ej. "Mantén F6 para clicar") -->
                    <TextBlock x:Name="HotkeyHintText" Text="" Margin="0,8,0,0" HorizontalAlignment="Center"
                               Style="{StaticResource CaptionStyle}" />
                </StackPanel>

                <!-- Opciones esenciales -->
                <Border x:Name="OptionsCard" Style="{StaticResource ListCardStyle}">
                    <StackPanel>
                        <!-- Intervalo -->
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="4">
                                    <RadioButton x:Name="UnitMsRadio" Content="ms" GroupName="Unit" IsChecked="True" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="UnitSRadio" Content="s" GroupName="Unit" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="UnitMinRadio" Content="min" GroupName="Unit" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="UnitHRadio" Content="h" GroupName="Unit" Style="{StaticResource CompactSegmentStyle}" />
                                </UniformGrid>
                            </Border>
                            <TextBox x:Name="IntervalBox" DockPanel.Dock="Right" Text="100" MaxLength="6" Width="68"
                                     Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="{l:T Interval}" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>

                        <Border Style="{StaticResource ListDividerStyle}" />

                        <!-- Botón -->
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="LeftButtonRadio" Content="{l:T Left}" GroupName="MouseButton" IsChecked="True" Style="{StaticResource SegmentStyle}" />
                                    <RadioButton x:Name="RightButtonRadio" Content="{l:T Right}" GroupName="MouseButton" Style="{StaticResource SegmentStyle}" />
                                    <RadioButton x:Name="MiddleButtonRadio" Content="{l:T Middle}" GroupName="MouseButton" Style="{StaticResource SegmentStyle}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{l:T Button}" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>

                        <Border Style="{StaticResource ListDividerStyle}" />

                        <!-- Tipo -->
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="SingleKindRadio" Content="{l:T Single}" GroupName="ClickKind" IsChecked="True" Style="{StaticResource SegmentStyle}" />
                                    <RadioButton x:Name="DoubleKindRadio" Content="{l:T Double}" GroupName="ClickKind" Style="{StaticResource SegmentStyle}" />
                                    <RadioButton x:Name="HoldKindRadio" Content="{l:T Hold}" GroupName="ClickKind" Style="{StaticResource SegmentStyle}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{l:T Type}" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource DetailRowStyle}"
                                   Visibility="{Binding IsChecked, ElementName=HoldKindRadio, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" Text="ms" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="HoldBox" DockPanel.Dock="Right" Text="100" MaxLength="6" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="{l:T HoldFor}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Style="{StaticResource ListDividerStyle}" />

                        <!-- Repetir -->
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="RepeatForeverRadio" Content="{l:T Forever}" GroupName="Repeat" IsChecked="True" Style="{StaticResource SegmentStyle}" />
                                    <RadioButton x:Name="RepeatCountRadio" Content="{l:T Times}" GroupName="Repeat" Style="{StaticResource SegmentStyle}" />
                                    <RadioButton x:Name="RepeatTimeRadio" Content="{l:T Time}" GroupName="Repeat" Style="{StaticResource SegmentStyle}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{l:T Repeat}" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource DetailRowStyle}"
                                   Visibility="{Binding IsChecked, ElementName=RepeatCountRadio, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="RepeatUnitText" DockPanel.Dock="Right" Text="{l:T UnitClicks}" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="RepeatCountBox" DockPanel.Dock="Right" Text="100" MaxLength="9" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="{l:T StopAfter}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource DetailRowStyle}"
                                   Visibility="{Binding IsChecked, ElementName=RepeatTimeRadio, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" Text="s" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="DurationBox" DockPanel.Dock="Right" Text="60" MaxLength="6" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="{l:T ClickFor}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Style="{StaticResource ListDividerStyle}" />

                        <!-- Posición -->
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="CursorPositionRadio" Content="Cursor" GroupName="Position" IsChecked="True" Style="{StaticResource SegmentStyle}"
                                                 ToolTip="{l:T CursorTip}" />
                                    <RadioButton x:Name="FixedPositionRadio" Content="{l:T Fixed}" GroupName="Position" Style="{StaticResource SegmentStyle}"
                                                 ToolTip="{l:T FixedTip}" />
                                    <RadioButton x:Name="PointsPositionRadio" Content="{l:T Points}" GroupName="Position" Style="{StaticResource SegmentStyle}"
                                                 Checked="PointsMode_Changed" Unchecked="PointsMode_Changed"
                                                 ToolTip="{l:T PointsTip}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{l:T Position}" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource DetailRowStyle}"
                                   Visibility="{Binding IsChecked, ElementName=FixedPositionRadio, Converter={StaticResource BoolToVis}}">
                            <Button x:Name="PickButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="PickPosition_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" ToolTip="{l:T PickTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B0;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{l:T Pick}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="YBox" DockPanel.Dock="Right" Text="0" MaxLength="6" Width="62" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock DockPanel.Dock="Right" Text="Y" Margin="10,0,6,0" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                            <TextBox x:Name="XBox" DockPanel.Dock="Right" Text="0" MaxLength="6" Width="62" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock DockPanel.Dock="Right" Text="X" Margin="0,0,6,0" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                            <TextBlock />
                        </DockPanel>
                        <StackPanel Visibility="{Binding IsChecked, ElementName=PointsPositionRadio, Converter={StaticResource BoolToVis}}">
                            <DockPanel Style="{StaticResource DetailRowStyle}">
                                <Button x:Name="AddPointsButton" DockPanel.Dock="Right" Margin="6,0,0,0" Click="AddPoints_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" ToolTip="{l:T AddTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{l:T Add}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RecordButton" DockPanel.Dock="Right" Margin="6,0,0,0" Click="RecordPoints_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="{l:T RecordTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#E5484D" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:T Record}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ClearPointsButton" DockPanel.Dock="Right" Click="ClearPoints_Click" Padding="9,0" IsEnabled="False"
                                        Style="{StaticResource SecondaryButtonStyle}" ToolTip="{l:T ClearTip}">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                </Button>
                                <TextBlock x:Name="PointsSummaryText" Text="{l:T NoPoints}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" Style="{StaticResource CaptionStyle}"
                                           ToolTip="{l:T PointsHint}" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource DetailRowStyle}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentedContainerStyle}">
                                    <UniformGrid Columns="4">
                                        <RadioButton x:Name="SpeedHalfRadio" Content="{l:T SpeedHalf}" GroupName="Speed" Style="{StaticResource CompactSegmentStyle}" />
                                        <RadioButton x:Name="Speed1Radio" Content="×1" GroupName="Speed" IsChecked="True" Style="{StaticResource CompactSegmentStyle}" />
                                        <RadioButton x:Name="Speed2Radio" Content="×2" GroupName="Speed" Style="{StaticResource CompactSegmentStyle}" />
                                        <RadioButton x:Name="Speed4Radio" Content="×4" GroupName="Speed" Style="{StaticResource CompactSegmentStyle}" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock Text="{l:T Speed}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                           ToolTip="{l:T SpeedTip}" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= Macros (grabar y reproducir ratón y teclado) ================= -->
            <StackPanel x:Name="MacrosPage" Margin="12,0,16,16" Visibility="Collapsed">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>

                <!-- Lectura: estado, duración / posición y botones -->
                <StackPanel Margin="2,6,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource IdleDotBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=PlayMacroButton}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock x:Name="MacroStatusText" Text="" Margin="7,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=PlayMacroButton}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock x:Name="MacroTimeText" Text="00:00" Margin="-2,6,0,0" FontFamily="{StaticResource NumberFont}"
                               FontSize="52" LineStackingStrategy="BlockLineHeight" LineHeight="48" />
                    <TextBlock x:Name="MacroDetailText" Text="" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionStyle}" />

                    <!-- Progreso de la vuelta (solo al reproducir) -->
                    <Grid x:Name="MacroProgress" Height="3" Margin="0,10,0,0" Visibility="Collapsed">
                        <Border CornerRadius="1.5" Background="{DynamicResource ControlHoverBrush}" />
                        <Border x:Name="MacroProgressFill" CornerRadius="1.5" HorizontalAlignment="Left" Width="0"
                                Background="{DynamicResource SuccessBrush}" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="RecordMacroButton" Grid.Column="0" Style="{StaticResource RecordToggleStyle}"
                                      Content="{l:T MacroRecord}" t:Ui.CheckedText="{l:T Finish}" t:Ui.KeyText="F7"
                                      ToolTip="{l:T MacroRecordTip}"
                                      Checked="RecordMacro_Checked" Unchecked="RecordMacro_Unchecked" />
                        <ToggleButton x:Name="PlayMacroButton" Grid.Column="2" Style="{StaticResource PrimaryToggleStyle}"
                                      Content="{l:T MacroPlay}" t:Ui.CheckedText="{l:T StopBtn}" t:Ui.KeyText="F8"
                                      Checked="PlayMacro_Checked" Unchecked="PlayMacro_Unchecked" />
                    </Grid>
                </StackPanel>

                <Border x:Name="MacroOptionsCard" Style="{StaticResource ListCardStyle}">
                    <StackPanel>
                        <!-- Macro elegida: menú con la biblioteca (elegir, renombrar, duplicar, exportar, importar, borrar) -->
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Button x:Name="MacroPickButton" DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="200"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="MacroPick_Click" ToolTip="{l:T MacroLibraryTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="MacroNameText" Text="{l:T MacroNone}" TextTrimming="CharacterEllipsis"
                                               MaxWidth="150" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                               Margin="8,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{l:T Macro}" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />

                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="4">
                                    <RadioButton x:Name="MacroOnceRadio" Content="{l:T MacroOnce}" GroupName="MacroRepeat" IsChecked="True" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="MacroCountRadio" Content="{l:T Times}" GroupName="MacroRepeat" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="MacroForeverRadio" Content="{l:T Forever}" GroupName="MacroRepeat" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="MacroTimeRadio" Content="{l:T Time}" GroupName="MacroRepeat" Style="{StaticResource CompactSegmentStyle}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{l:T Repeat}" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource DetailRowStyle}"
                                   Visibility="{Binding IsChecked, ElementName=MacroCountRadio, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" Text="{l:T MacroLoops}" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="MacroCountBox" DockPanel.Dock="Right" Text="10" MaxLength="6" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="{l:T MacroPlayTimes}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource DetailRowStyle}"
                                   Visibility="{Binding IsChecked, ElementName=MacroTimeRadio, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" Text="min" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="MacroMinutesBox" DockPanel.Dock="Right" Text="10" MaxLength="4" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="{l:T MacroPlayFor}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />

                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="5">
                                    <RadioButton x:Name="MacroSpeedHalf" Content="{l:T SpeedHalf}" GroupName="MacroSpeed" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="MacroSpeed1" Content="×1" GroupName="MacroSpeed" IsChecked="True" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="MacroSpeed2" Content="×2" GroupName="MacroSpeed" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="MacroSpeed4" Content="×4" GroupName="MacroSpeed" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="MacroSpeed10" Content="×10" GroupName="MacroSpeed" Style="{StaticResource CompactSegmentStyle}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{l:T Speed}" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />

                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="MacroModeAll" Content="{l:T MacroModeAll}" GroupName="MacroMode" IsChecked="True" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="MacroModeMouse" Content="{l:T MacroModeMouse}" GroupName="MacroMode" Style="{StaticResource CompactSegmentStyle}" />
                                    <RadioButton x:Name="MacroModeKeys" Content="{l:T MacroModeKeys}" GroupName="MacroMode" Style="{StaticResource CompactSegmentStyle}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{l:T MacroRecordWhat}" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= Anti-AFK (experimental) ================= -->
            <StackPanel x:Name="AntiAfkPage" Margin="12,0,16,16" Visibility="Collapsed">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>

                <!-- Lectura: estado, cuenta atrás hasta el próximo clic y botón principal -->
                <StackPanel Margin="2,6,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource IdleDotBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=AntiAfkSwitch}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock x:Name="AntiAfkStatusText" Text="{l:T AfkStateOff}" Margin="7,0,0,0" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=AntiAfkSwitch}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock x:Name="AfkCountdownText" Text="15:00" Margin="-2,6,0,0" FontFamily="{StaticResource NumberFont}"
                               FontSize="52" LineStackingStrategy="BlockLineHeight" LineHeight="48" />
                    <TextBlock x:Name="AfkDetailText" Text="" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" />

                    <ToggleButton x:Name="AntiAfkSwitch" Margin="0,16,0,0" Style="{StaticResource PrimaryToggleStyle}"
                                  Content="{l:T AfkStart}" t:Ui.CheckedText="{l:T AfkStop}" ToolTip="{l:T AntiAfkTip}"
                                  Checked="AntiAfk_Changed" Unchecked="AntiAfk_Changed" />
                </StackPanel>

                <Border Style="{StaticResource ListCardStyle}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource ListRowStyle}" MinHeight="56">
                            <Button x:Name="AfkPickButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                                    Click="AfkPick_Click" Style="{StaticResource SecondaryButtonStyle}" ToolTip="{l:T AfkPickTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B0;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T Pick}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:T AfkTarget}" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock x:Name="AfkTargetText" Text="{l:T AfkNoTarget}" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource RowHintStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}" MinHeight="56">
                            <TextBlock DockPanel.Dock="Right" Text="min" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="AfkMinutesBox" DockPanel.Dock="Right" Text="15" MaxLength="2" VerticalAlignment="Center"
                                     Style="{StaticResource SmallFieldStyle}" TextChanged="AfkMinutes_Changed" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:T AfkEvery}" Style="{StaticResource RowTitleStyle}"
                                           ToolTip="{l:T AfkEveryTip}" />
                                <TextBlock Text="{l:T AfkEveryHint}" Style="{StaticResource RowHintStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}" MinHeight="56">
                            <Button x:Name="AfkTestButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                                    Click="AfkTest_Click" Style="{StaticResource SecondaryButtonStyle}" Content="{l:T AfkTestNow}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:T AfkTest}" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="{l:T AfkTestHint}" Style="{StaticResource RowHintStyle}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:T AfkExperimentalNote}" Margin="2,12,2,0" TextWrapping="Wrap"
                           Style="{StaticResource CaptionStyle}" />
            </StackPanel>

            <!-- ================= Página de ajustes ================= -->
            <!-- Ajustes: con scroll si no cabe (la página principal nunca lo tiene) -->
            <!-- Visible solo con Ajustes abierto: el contenedor comparte celda con Clics y, aunque su
                 contenido esté oculto, se quedaría encima tragándose los clics de ratón. -->
            <ScrollViewer x:Name="SettingsScroll" Style="{StaticResource ThinScrollViewerStyle}" Focusable="False"
                          Visibility="{Binding Visibility, ElementName=SettingsPage}">
            <StackPanel x:Name="SettingsPage" Margin="12,0,16,16" Visibility="Collapsed">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>

                <TextBlock Text="{l:T Settings}" Margin="2,4,0,0" FontFamily="{StaticResource DisplayFont}"
                           FontSize="20" FontWeight="SemiBold" />

                <!-- Atajo -->
                <TextBlock Text="{l:T Hotkey}" Style="{StaticResource GroupLabelStyle}" />
                <Border x:Name="HotkeyCard" Style="{StaticResource ListCardStyle}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource ListRowStyle}" MinHeight="56">
                            <ToggleButton x:Name="HotkeyButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Content="F6" Style="{StaticResource KeyCapStyle}"
                                          Checked="AnyHotkeyButton_Checked" Unchecked="AnyHotkeyButton_Unchecked" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:T StartStop}" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock x:Name="HotkeyNoteText" Text="{l:T HotkeyWorksHidden}"
                                           Style="{StaticResource RowHintStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="ToggleModeRadio" Content="{l:T Toggle}" GroupName="HotkeyMode" IsChecked="True" Style="{StaticResource SegmentStyle}"
                                                 ToolTip="{l:T ToggleTip}" />
                                    <RadioButton x:Name="HoldModeRadio" Content="{l:T Hold}" GroupName="HotkeyMode" Style="{StaticResource SegmentStyle}"
                                                 ToolTip="{l:T HoldModeTip}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{l:T Mode}" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <ToggleButton x:Name="RecordHotkeyButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Content="F7" Style="{StaticResource KeyCapStyle}"
                                          Checked="AnyHotkeyButton_Checked" Unchecked="AnyHotkeyButton_Unchecked" />
                            <TextBlock Text="{l:T MacroRecordHotkey}" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <ToggleButton x:Name="PlayHotkeyButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Content="F8" Style="{StaticResource KeyCapStyle}"
                                          Checked="AnyHotkeyButton_Checked" Unchecked="AnyHotkeyButton_Unchecked" />
                            <TextBlock Text="{l:T MacroPlayHotkey}" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Clics -->
                <TextBlock Text="{l:T ClicksGroup}" Style="{StaticResource GroupLabelStyle}" />
                <Border x:Name="ClicksCard" Style="{StaticResource ListCardStyle}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <TextBlock DockPanel.Dock="Right" Text="± %" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="JitterBox" DockPanel.Dock="Right" Text="0" MaxLength="2" VerticalAlignment="Center" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="{l:T Jitter}" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="{l:T JitterTip}" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <TextBlock DockPanel.Dock="Right" Text="± px" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="OffsetBox" DockPanel.Dock="Right" Text="0" MaxLength="4" VerticalAlignment="Center" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="{l:T Offset}" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="{l:T OffsetTip}" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <TextBlock DockPanel.Dock="Right" Text="s" Style="{StaticResource UnitStyle}" />
                            <TextBox x:Name="DelayBox" DockPanel.Dock="Right" Text="0" MaxLength="3" VerticalAlignment="Center" Style="{StaticResource SmallFieldStyle}" />
                            <TextBlock Text="{l:T Delay}" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="{l:T DelayTip}" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <CheckBox x:Name="LockWindowSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}" />
                            <TextBlock Text="{l:T LockWindow}" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="{l:T LockWindowTip}" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <CheckBox x:Name="RestoreCursorSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}" />
                            <TextBlock Text="{l:T RestoreCursor}" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="{l:T RestoreCursorTip}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- General -->
                <TextBlock Text="{l:T General}" Style="{StaticResource GroupLabelStyle}" />
                <Border Style="{StaticResource ListCardStyle}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <CheckBox x:Name="EmergencySwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      IsChecked="True" Style="{StaticResource ToggleSwitchStyle}" />
                            <TextBlock Text="{l:T Emergency}" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="{l:T EmergencyTip}" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <CheckBox x:Name="MinimizeToTraySwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      IsChecked="True" Style="{StaticResource ToggleSwitchStyle}" />
                            <TextBlock Text="{l:T MinToTray}" Style="{StaticResource RowTitleStyle}" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <CheckBox x:Name="CloseToTraySwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}" />
                            <TextBlock Text="{l:T CloseToTray}" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="{l:T CloseToTrayTip}" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <CheckBox x:Name="StartWithWindowsSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed" />
                            <TextBlock Text="{l:T StartWithWindows}" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="{l:T StartWithWindowsTip}" />
                        </DockPanel>
                        <Border Style="{StaticResource ListDividerStyle}" />
                        <DockPanel Style="{StaticResource ListRowStyle}">
                            <CheckBox x:Name="TranslucentSwitch" DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="True"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="Translucent_Changed" Unchecked="Translucent_Changed" />
                            <TextBlock Text="{l:T Translucent}" Style="{StaticResource RowTitleStyle}"
                                       ToolTip="{l:T TranslucentTip}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Experimental: al encenderlo aparecen las funciones en pruebas (de momento, el Anti-AFK) -->
                <TextBlock Text="{l:T Experimental}" Style="{StaticResource GroupLabelStyle}" />
                <Border Style="{StaticResource ListCardStyle}">
                    <DockPanel Style="{StaticResource ListRowStyle}" MinHeight="56">
                        <CheckBox x:Name="ExperimentalSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="Experimental_Changed" Unchecked="Experimental_Changed" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{l:T ExperimentalTitle}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{l:T ExperimentalHint}" Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Acerca de -->
                <TextBlock Text="{l:T About}" Style="{StaticResource GroupLabelStyle}" />
                <Border Style="{StaticResource ListCardStyle}">
                    <DockPanel Style="{StaticResource ListRowStyle}" MinHeight="56">
                        <Button x:Name="OpenDataFolderButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                                Click="OpenDataFolder_Click" Style="{StaticResource SecondaryButtonStyle}"
                                Content="{l:T OpenDataFolder}" ToolTip="{l:T OpenDataFolderTip}" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="AboutVersionText" Text="AutoClik" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{l:T AboutHint}" Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
