<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AutoClik sobre .NET Framework 4.8, que ya viene con Windows 10 (1903+) y Windows 11:
    el .exe no tiene que llevar .NET dentro, así que pesa < 1 MB y abre al instante.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Nombre del ejecutable y de la app (el código sigue en el espacio de nombres Autoclicker) -->
    <AssemblyName>AutoClik</AssemblyName>
    <RootNamespace>Autoclicker</RootNamespace>
    <Product>AutoClik</Product>
    <AssemblyTitle>AutoClik</AssemblyTitle>
    <Version>2.6.0</Version>
    <Copyright>© 2026 ale-castroh</Copyright>

    <!-- 64 bits en Windows x64 y nativo en ARM64 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
