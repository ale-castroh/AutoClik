<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta oscura (grafito). Las claves deben coincidir con Light.xaml.
         El acento (AccentBrush, AccentTextBrush...) lo pone ThemeManager según Windows. -->
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#1C1E22" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEDEF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9AEB6" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7C828B" />

    <!-- Hoja de opciones (una lista con líneas finas) -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="CardTranslucentBrush" Color="#8C1E2025" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ControlStrongBorderBrush" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="FieldUnderlineBrush" Color="#5CFFFFFF" />

    <!-- Selector segmentado: fondo hundido y opción elegida "elevada" en gris -->
    <SolidColorBrush x:Key="TrackBackgroundBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#3A3E45" />
    <SolidColorBrush x:Key="SegmentSelectedBorderBrush" Color="#14FFFFFF" />

    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#0FFFFFFF" />

    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#2B2D31" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3CCF87" />
    <SolidColorBrush x:Key="IdleDotBrush" Color="#6B717B" />
</ResourceDictionary>
