<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta oscura. Las claves deben coincidir con Light.xaml. -->
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#202020" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF" />

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#14FFFFFF" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ControlStrongBorderBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="TrackBackgroundBrush" Color="#33000000" />

    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#15FFFFFF" />

    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
</ResourceDictionary>
