<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta clara. Las claves deben coincidir con Dark.xaml. -->
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#F3F3F3" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4000000" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E000000" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#72000000" />

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#0F000000" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#80F9F9F9" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#17000000" />
    <SolidColorBrush x:Key="ControlStrongBorderBrush" Color="#72000000" />
    <SolidColorBrush x:Key="TrackBackgroundBrush" Color="#08000000" />

    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#06000000" />
    <SolidColorBrush x:Key="DividerBrush" Color="#0F000000" />

    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#F9F9F9" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
</ResourceDictionary>
