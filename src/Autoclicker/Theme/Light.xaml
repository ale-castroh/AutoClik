<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta clara. Las claves deben coincidir con Dark.xaml.
         El acento (AccentBrush, AccentTextBrush...) lo pone ThemeManager según Windows. -->
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#F3F4F6" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#16181B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C626B" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A9099" />

    <!-- Hoja de opciones (una lista con líneas finas) -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000" />
    <SolidColorBrush x:Key="CardTranslucentBrush" Color="#D9FFFFFF" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="ControlStrongBorderBrush" Color="#73000000" />
    <SolidColorBrush x:Key="FieldUnderlineBrush" Color="#73000000" />

    <!-- Selector segmentado: fondo hundido y opción elegida "elevada" en blanco -->
    <SolidColorBrush x:Key="TrackBackgroundBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SegmentSelectedBorderBrush" Color="#1F000000" />

    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#06000000" />
    <SolidColorBrush x:Key="DividerBrush" Color="#0F000000" />

    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#FBFBFC" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1F9D57" />
    <SolidColorBrush x:Key="IdleDotBrush" Color="#9AA0A6" />
</ResourceDictionary>
