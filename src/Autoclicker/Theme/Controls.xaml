<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Autoclicker.Localization"
        xmlns:t="clr-namespace:Autoclicker.Theme">

    <!-- ============ Tipografía ============ -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- Números (contador, cuenta atrás, campos): Bahnschrift, la tipografía tipo cronómetro de Windows -->
    <FontFamily x:Key="NumberFont">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- ============ Formas dibujadas ============ -->
    <!-- En vez de letras de una fuente de iconos: así quedan centradas al píxel. -->
    <!-- Logo: ratón centrado en una rejilla de 24 (x 7,75-16,25, y 5-19) y chispa de tres rayas
         iguales en abanico (210°, 225°, 240° desde el centro del arco superior, 12,9.25), separadas 1,4 del contorno. Las mismas formas
         que Interop/IconFactory.cs y tools/make-icon.ps1. -->
    <Geometry x:Key="LogoBodyGeometry">M12,5.0 C14.35,5.0 16.25,6.90 16.25,9.25 L16.25,14.75 C16.25,17.10 14.35,19.0 12,19.0 C9.65,19.0 7.75,17.10 7.75,14.75 L7.75,9.25 C7.75,6.90 9.65,5.0 12,5.0 Z</Geometry>
    <Geometry x:Key="LogoLinesGeometry">M7.75,10.5 L16.25,10.5 M12,5.0 L12,10.5</Geometry>
    <Geometry x:Key="LogoSparkGeometry">M5.98,5.77 L3.56,4.37 M7.09,4.34 L5.11,2.36 M8.52,3.23 L7.12,0.81</Geometry>
    <SolidColorBrush x:Key="LogoInkBrush" Color="#1C1E22" />
    <SolidColorBrush x:Key="LogoSparkBrush" Color="#FFB000" />
    <Geometry x:Key="PlayGeometry">M0,0 L9,5.5 L0,11 Z</Geometry>

    <Duration x:Key="FastDuration">0:0:0.12</Duration>

    <!-- ============ Foco de teclado ============ -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="7" RadiusY="7" StrokeThickness="2"
                               Stroke="{DynamicResource TextPrimaryBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Textos ============ -->
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- ============ Tarjeta ============ -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============ Botones de la barra de título ============ -->
    <Style x:Key="TitleBarButtonStyle" TargetType="ButtonBase">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" CornerRadius="6" Opacity="0"
                                Background="{TemplateBinding Background}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource FastDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource FastDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Setter Property="Background" Value="#C42B1C" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TitleBarPinStyle" TargetType="ToggleButton" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Content" Value="&#xE718;" />
        <Setter Property="ToolTip" Value="{l:T PinTip}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="&#xE840;" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="ToolTip" Value="{l:T UnpinTip}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Barra lateral: un botón por sección ============ -->
    <!-- Tag = true muestra el puntito verde (esa función está en marcha). -->
    <Style x:Key="NavButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" Height="14" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-7,0,0,0"
                                Background="{DynamicResource AccentTextBrush}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse x:Name="Dot" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,5,5,0" Fill="{DynamicResource SuccessBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Botón principal (Iniciar / Detener, Iniciar / Detener anti-AFK) ============ -->
    <!-- Content = texto en reposo; t:Ui.CheckedText = texto activo; t:Ui.KeyText = tecla (F6).
         El triángulo y el cuadrado son formas dibujadas: quedan centrados al píxel. -->
    <Style x:Key="PrimaryToggleStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bg" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource AccentBrush}" BorderBrush="Transparent" />
                        <Border x:Name="Hover" CornerRadius="6" Opacity="0" Background="{DynamicResource TextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,9,0">
                                <!-- El triángulo se desplaza 1 px: su centro visual está a la izquierda de su caja -->
                                <Path x:Name="PlayIcon" Data="{StaticResource PlayGeometry}" Stretch="Uniform" Width="10" Height="12"
                                      Margin="1,0,0,0" Fill="{TemplateBinding Foreground}" />
                                <Rectangle x:Name="StopIcon" Width="10" Height="10" RadiusX="2" RadiusY="2"
                                           Fill="{TemplateBinding Foreground}" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock x:Name="Label" VerticalAlignment="Center"
                                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border x:Name="Key" Margin="10,0,0,0" Padding="6,1,6,2" CornerRadius="4" VerticalAlignment="Center"
                                    Background="#33FFFFFF">
                                <TextBlock FontFamily="{StaticResource NumberFont}" FontSize="12" FontWeight="Normal"
                                           Text="{Binding (t:Ui.KeyText), RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding (t:Ui.KeyText), RelativeSource={RelativeSource Self}}" Value="">
                            <Setter TargetName="Key" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.14" />
                        </Trigger>
                        <!-- Activo: contorno en vez de relleno, cuadrado de "detener" y su texto -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlStrongBorderBrush}" />
                            <Setter TargetName="Key" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            <Setter TargetName="PlayIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StopIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Label" Property="Text"
                                    Value="{Binding (t:Ui.CheckedText), RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Botón Grabar (secundario, con punto rojo y tecla) ============ -->
    <!-- Content = "Grabar"; t:Ui.CheckedText = "Terminar"; t:Ui.KeyText = tecla (F7). -->
    <Style x:Key="RecordToggleStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bg" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,9,0">
                                <Ellipse x:Name="RecIcon" Width="10" Height="10" Fill="#E5484D" />
                                <Rectangle x:Name="StopIcon" Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#E5484D" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock x:Name="Label" VerticalAlignment="Center"
                                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border x:Name="Key" Margin="10,0,0,0" Padding="6,1,6,2" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlHoverBrush}">
                                <TextBlock FontFamily="{StaticResource NumberFont}" FontSize="12" FontWeight="Normal"
                                           Text="{Binding (t:Ui.KeyText), RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding (t:Ui.KeyText), RelativeSource={RelativeSource Self}}" Value="">
                            <Setter TargetName="Key" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#E5484D" />
                            <Setter TargetName="RecIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StopIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Label" Property="Text"
                                    Value="{Binding (t:Ui.CheckedText), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Control segmentado (RadioButtons) ============ -->
    <!-- Fondo hundido; la opción elegida se "eleva" en gris (no en color de acento). -->
    <Style x:Key="SegmentedContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TrackBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style x:Key="SegmentStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Selected" CornerRadius="5" BorderThickness="1" Opacity="0"
                                Background="{DynamicResource SegmentSelectedBrush}"
                                BorderBrush="{DynamicResource SegmentSelectedBorderBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource FastDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource FastDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactSegmentStyle" TargetType="RadioButton" BasedOn="{StaticResource SegmentStyle}">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ============ Campo de texto / número ============ -->
    <!-- Como en Windows 11: borde fino, línea inferior, y línea de acento al escribir. -->
    <Style x:Key="FieldStyle" TargetType="TextBox">
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bg" CornerRadius="5" BorderThickness="1"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}" />
                        <Border x:Name="Line" Height="1" VerticalAlignment="Bottom" Margin="4,0"
                                Background="{DynamicResource FieldUnderlineBrush}" />
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="1,0"
                                CornerRadius="0,0,5,5" Background="{DynamicResource AccentBrush}" Opacity="0" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="6,0" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                            <Setter TargetName="Line" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- ============ Hoja de opciones (una lista, filas separadas por líneas finas) ============ -->
    <Style x:Key="ListCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ListRowStyle" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="12,0" />
    </Style>

    <!-- Línea extra bajo una fila (p. ej. "Veces" -> número de clics) -->
    <Style x:Key="DetailRowStyle" TargetType="DockPanel">
        <Setter Property="Margin" Value="12,0,12,10" />
    </Style>

    <Style x:Key="ListDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>

    <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,18,0,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="RowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="RowHintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,1,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SmallFieldStyle" TargetType="TextBox" BasedOn="{StaticResource FieldStyle}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Width" Value="64" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
    </Style>

    <Style x:Key="UnitStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="MinWidth" Value="26" />
    </Style>

    <!-- ============ Botón secundario ============ -->
    <Style x:Key="SecondaryButtonStyle" TargetType="ButtonBase">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bg" CornerRadius="5" BorderThickness="1"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Tecla del atajo (pulsar para reasignar) ============ -->
    <Style x:Key="KeyCapStyle" TargetType="ToggleButton" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="ToolTip" Value="{l:T KeyCapTip}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bg" CornerRadius="5" BorderThickness="1"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}" />
                        <ContentPresenter Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Blink">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.55" Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="Blink" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Interruptor (CheckBox) ============ -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="38" Height="20" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                Background="Transparent" BorderBrush="{DynamicResource ControlStrongBorderBrush}" />
                        <Ellipse x:Name="Knob" Width="10" Height="10" HorizontalAlignment="Left" Margin="5,0,0,0"
                                 Fill="{DynamicResource TextSecondaryBrush}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobMove" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccentBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="12" />
                            <Setter TargetName="Knob" Property="Height" Value="12" />
                            <Setter TargetName="Knob" Property="Margin" Value="4,0,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Scroll fino ============ -->
    <Style x:Key="ThinScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Center"
                                                    Background="{DynamicResource TextTertiaryBrush}" Opacity="0.7" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bar" Property="Width" Value="6" />
                                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="Bar" Property="Width" Value="6" />
                                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThinScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource ThinScrollBarStyle}"
                                   HorizontalAlignment="Right" Margin="0,2,3,2"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Menú contextual (bandeja) ============ -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Padding="4" CornerRadius="8" BorderThickness="1" MinWidth="190"
                            Background="{DynamicResource ToolTipBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" CornerRadius="5" Padding="10,7" Background="Transparent">
                        <DockPanel>
                            <ContentPresenter ContentSource="Icon" Width="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                              TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="13" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="4,4" Background="{DynamicResource DividerBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Tooltip (implícito) ============ -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Padding="9,5" CornerRadius="6" BorderThickness="1"
                            Background="{DynamicResource ToolTipBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
