<Window x:Class="Autoclicker.Views.PowerCountdown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Autoclicker.Localization"
        Title="AutoClik"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Margin="14" Padding="20,18" Width="360" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource ToolTipBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{l:T PowerHint}" Margin="0,6,0,0" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="NowButton" MinWidth="100" Style="{StaticResource SecondaryButtonStyle}" Click="Now_Click" />
                <Button x:Name="CancelButton" Content="{l:T Cancel}" MinWidth="100" Margin="8,0,0,0" IsDefault="True" IsCancel="True"
                        Style="{StaticResource AccentButtonStyle}" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
