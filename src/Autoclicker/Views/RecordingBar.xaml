<Window x:Class="Autoclicker.Views.RecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grabando"
        SizeToContent="WidthAndHeight" Left="-32000" Top="-32000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- Píldora flotante arriba en el centro mientras se graba -->
    <Border Margin="12" Padding="14,8,8,8" CornerRadius="22" BorderThickness="1"
            Background="{DynamicResource ToolTipBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.3" Color="Black" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal">
            <!-- Punto rojo que late -->
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#E5484D" VerticalAlignment="Center">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="30">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.8" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <TextBlock Text="Grabando" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="InfoText" Text="0 clics · 0:00" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock x:Name="HintText" Text="Esc para terminar" Margin="12,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource CaptionStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />

            <Button x:Name="StopButton" Margin="14,0,0,0" Height="30" Padding="12,0" Click="Stop_Click"
                    Style="{StaticResource SecondaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="9" Height="9" CornerRadius="2" Background="#E5484D" VerticalAlignment="Center" />
                    <TextBlock Text="Terminar" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
