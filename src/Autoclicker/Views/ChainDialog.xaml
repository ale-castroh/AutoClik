<Window x:Class="Autoclicker.Views.ChainDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Autoclicker.Localization"
        Title="Cadena"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="ChainItemStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel>
                            <Border x:Name="Bg" Margin="3,1" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent"
                                    Background="Transparent">
                                <DockPanel Height="30" Margin="8,0">
                                    <TextBlock DockPanel.Dock="Left" Width="20" Text="{Binding Number}" FontSize="11"
                                               FontFamily="{StaticResource NumberFont}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{Binding Pause}" Visibility="{Binding PauseVisibility}" Margin="34,0,0,2" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource SegmentSelectedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" Padding="18,16" Width="380" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource ToolTipBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.3" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{l:T ChainHint}" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" />

            <TextBox x:Name="NameBox" Margin="0,12,0,0" MaxLength="40" TextAlignment="Left"
                     Style="{StaticResource FieldStyle}" FontSize="13" FontFamily="{StaticResource UiFont}" />

            <Border Margin="0,12,0,0" Style="{StaticResource ListCardStyle}" Height="190">
                <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0" Padding="0,3"
                         ItemContainerStyle="{StaticResource ChainItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ItemList_SelectionChanged">
                    <ListBox.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ThinScrollViewerStyle}" />
                    </ListBox.Resources>
                </ListBox>
            </Border>

            <DockPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddButton" Style="{StaticResource SecondaryButtonStyle}" Click="Add_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T ChainAdd}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RemoveButton" Content="{l:T ChainRemove}" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                            Click="Remove_Click" />
                    <Button x:Name="UpButton" Content="&#xE74A;" Width="30" Padding="0" Margin="6,0,0,0" FontFamily="{StaticResource IconFont}"
                            Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="{l:T EditorMoveUp}" Click="Up_Click" />
                    <Button x:Name="DownButton" Content="&#xE74B;" Width="30" Padding="0" Margin="4,0,0,0" FontFamily="{StaticResource IconFont}"
                            Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="{l:T EditorMoveDown}" Click="Down_Click" />
                </StackPanel>
            </DockPanel>

            <!-- Elemento elegido: veces y pausa después -->
            <Grid x:Name="ItemFields" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBox x:Name="TimesBox" DockPanel.Dock="Right" MaxLength="4" Style="{StaticResource SmallFieldStyle}" Width="56"
                             TextChanged="Fields_Changed" />
                    <TextBlock Text="{l:T ChainTimes}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Right" Text="s" Style="{StaticResource UnitStyle}" MinWidth="12" />
                    <TextBox x:Name="PauseBox" DockPanel.Dock="Right" MaxLength="6" Style="{StaticResource SmallFieldStyle}" Width="56"
                             TextChanged="Fields_Changed" />
                    <TextBlock Text="{l:T ChainPause}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </DockPanel>
            </Grid>

            <TextBlock x:Name="ErrorText" Margin="2,10,0,0" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Foreground="#D13438" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="{l:T Cancel}" MinWidth="90" IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="{l:T Save}" MinWidth="90" Margin="8,0,0,0" IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
