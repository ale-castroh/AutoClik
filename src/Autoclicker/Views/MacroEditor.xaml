<Window x:Class="Autoclicker.Views.MacroEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Autoclicker.Localization"
        Title="AutoClik"
        Width="760" Height="560" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Botón de acento (Guardar) -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="5" Background="{DynamicResource AccentBrush}" />
                            <Border x:Name="Hover" CornerRadius="5" Opacity="0" Background="#22FFFFFF" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de la barra de herramientas: icono + texto, sin borde hasta pasar por encima -->
        <Style x:Key="ToolButtonStyle" TargetType="ButtonBase">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bg" CornerRadius="5" Background="Transparent" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fila de la lista de pasos: espera (línea fina) + icono, descripción y número -->
        <Style x:Key="StepItemStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="40,2,0,0" Visibility="{Binding WaitVisibility}">
                                <Border Width="1" Height="12" Background="{DynamicResource DividerBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Wait}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontFamily="{StaticResource NumberFont}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="Bg" Margin="4,1" CornerRadius="5" Background="Transparent" BorderThickness="1"
                                    BorderBrush="Transparent">
                                <DockPanel Height="30" Margin="8,0">
                                    <TextBlock DockPanel.Dock="Left" Width="24" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                               FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Number}" FontSize="11" Margin="8,0,0,0"
                                               FontFamily="{StaticResource NumberFont}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource SegmentSelectedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldRowStyle" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource RowTitleStyle}">
            <Setter Property="Width" Value="92" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Barra de título ================= -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Viewbox Width="22" Height="22" Margin="-2,0,0,0">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource LogoBodyGeometry}" Fill="White" Stroke="{StaticResource LogoInkBrush}" StrokeThickness="1.4" />
                        <Path Data="{StaticResource LogoLinesGeometry}" Stroke="{StaticResource LogoInkBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="{StaticResource LogoSparkGeometry}" Stroke="{StaticResource LogoSparkBrush}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="TitleText" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="380" />
                <TextBlock x:Name="SummaryText" Margin="12,1,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}"
                           FontFamily="{StaticResource NumberFont}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Content="&#xE8BB;"
                    ToolTip="{l:T Close}" Style="{StaticResource TitleBarCloseButtonStyle}" Click="Close_Click" />
        </Grid>

        <!-- ================= Barra de herramientas ================= -->
        <DockPanel Grid.Row="1" Margin="12,0,16,8">
            <Button x:Name="TestButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Height="30"
                    ToolTip="{l:T EditorTestTip}" Click="Test_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource PlayGeometry}" Fill="{DynamicResource AccentTextBrush}" Width="9" Height="10"
                          Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="{l:T EditorTest}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="InsertButton" Style="{StaticResource ToolButtonStyle}" ToolTip="{l:T EditorInsertTip}" Click="Insert_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource ToolIconStyle}" />
                        <TextBlock Text="{l:T EditorInsert}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" Style="{StaticResource ToolIconStyle}" FontSize="8" Margin="6,1,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteButton" Margin="2,0,0,0" Style="{StaticResource ToolButtonStyle}" Click="Delete_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource ToolIconStyle}" />
                        <TextBlock Text="{l:T EditorDelete}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource DividerBrush}" />
                <Button x:Name="UpButton" Width="32" Padding="0" Style="{StaticResource ToolButtonStyle}" ToolTip="{l:T EditorMoveUp}"
                        AutomationProperties.Name="{l:T EditorMoveUp}" Click="Up_Click">
                    <TextBlock Text="&#xE74A;" Style="{StaticResource ToolIconStyle}" />
                </Button>
                <Button x:Name="DownButton" Width="32" Padding="0" Style="{StaticResource ToolButtonStyle}" ToolTip="{l:T EditorMoveDown}"
                        AutomationProperties.Name="{l:T EditorMoveDown}" Click="Down_Click">
                    <TextBlock Text="&#xE74B;" Style="{StaticResource ToolIconStyle}" />
                </Button>
                <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource DividerBrush}" />
                <Button x:Name="UndoButton" Style="{StaticResource ToolButtonStyle}" ToolTip="Ctrl+Z" Click="Undo_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" Style="{StaticResource ToolIconStyle}" />
                        <TextBlock Text="{l:T EditorUndo}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ================= Lista de pasos + panel ================= -->
        <Grid Grid.Row="2" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="268" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ListCardStyle}">
                <ListBox x:Name="StepList" Background="Transparent" BorderThickness="0" Padding="0,4"
                         SelectionMode="Extended" ItemContainerStyle="{StaticResource StepItemStyle}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="StepList_SelectionChanged" PreviewKeyDown="StepList_PreviewKeyDown">
                    <ListBox.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ThinScrollViewerStyle}" />
                    </ListBox.Resources>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="2" Style="{StaticResource ThinScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Paso elegido -->
                    <Border Style="{StaticResource CardStyle}" Padding="14,12,14,4">
                        <StackPanel>
                            <TextBlock x:Name="StepTitleText" Style="{StaticResource GroupLabelStyle}" Margin="0,0,0,10"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NoSelectionText" Text="{l:T EditorNoSelection}" Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />

                            <DockPanel x:Name="WaitRow" Style="{StaticResource FieldRowStyle}">
                                <TextBlock Text="{l:T EditorWaitBefore}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="s" Style="{StaticResource UnitStyle}" DockPanel.Dock="Right" />
                                <TextBox x:Name="WaitBox" Style="{StaticResource SmallFieldStyle}" Width="NaN" TextChanged="Field_TextChanged" />
                            </DockPanel>

                            <DockPanel x:Name="KeyRow" Style="{StaticResource FieldRowStyle}">
                                <TextBlock Text="{l:T EditorKey}" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="KeyButton" Style="{StaticResource KeyCapStyle}" HorizontalAlignment="Left"
                                              MinWidth="60" Click="KeyButton_Click" />
                            </DockPanel>

                            <DockPanel x:Name="HoldRow" Style="{StaticResource FieldRowStyle}">
                                <TextBlock Text="{l:T EditorHold}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="s" Style="{StaticResource UnitStyle}" DockPanel.Dock="Right" />
                                <TextBox x:Name="HoldBox" Style="{StaticResource SmallFieldStyle}" Width="NaN" TextChanged="Field_TextChanged" />
                            </DockPanel>

                            <DockPanel x:Name="PositionRow" Style="{StaticResource FieldRowStyle}">
                                <TextBlock Text="{l:T EditorPosition}" Style="{StaticResource FieldLabelStyle}" />
                                <Button x:Name="PickPositionButton" DockPanel.Dock="Right" Content="{l:T Pick}" Margin="6,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}" ToolTip="{l:T PickTip}" Click="PickPosition_Click" />
                                <UniformGrid Columns="2">
                                    <TextBox x:Name="XBox" Style="{StaticResource SmallFieldStyle}" Width="NaN" Margin="0,0,3,0"
                                             TextChanged="Field_TextChanged" />
                                    <TextBox x:Name="YBox" Style="{StaticResource SmallFieldStyle}" Width="NaN" Margin="3,0,0,0"
                                             TextChanged="Field_TextChanged" />
                                </UniformGrid>
                            </DockPanel>

                            <DockPanel x:Name="ColorRow" Style="{StaticResource FieldRowStyle}">
                                <TextBlock Text="{l:T EditorColor}" Style="{StaticResource FieldLabelStyle}" />
                                <Border x:Name="WaitColorSwatch" Width="22" Height="22" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrongBorderBrush}" />
                                <TextBlock x:Name="WaitColorText" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource NumberFont}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </DockPanel>

                            <DockPanel x:Name="TimeoutRow" Style="{StaticResource FieldRowStyle}">
                                <TextBlock Text="{l:T EditorTimeout}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="s" Style="{StaticResource UnitStyle}" DockPanel.Dock="Right" />
                                <TextBox x:Name="TimeoutBox" Style="{StaticResource SmallFieldStyle}" Width="NaN" MaxLength="4"
                                         TextChanged="Field_TextChanged" />
                            </DockPanel>

                            <StackPanel x:Name="TextRow" Margin="0,0,0,10">
                                <TextBlock Text="{l:T EditorText}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                                <TextBox x:Name="StepTextBox" Style="{StaticResource FieldStyle}" FontFamily="{StaticResource UiFont}"
                                         FontSize="13" TextAlignment="Left" MaxLength="500" TextChanged="Field_TextChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Limpiar -->
                    <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T EditorClean}" Style="{StaticResource GroupLabelStyle}" Margin="0,0,0,10" />
                            <TextBlock Text="{l:T EditorShorten}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
                            <DockPanel>
                                <Button x:Name="ShortenButton" DockPanel.Dock="Right" Content="{l:T EditorApply}" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="Shorten_Click" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="ShortenBox" Text="2" Style="{StaticResource SmallFieldStyle}" />
                                    <TextBlock Text="s" Style="{StaticResource UnitStyle}" />
                                </StackPanel>
                            </DockPanel>
                            <Button x:Name="RemoveMovesButton" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                    Content="{l:T EditorRemoveMoves}" ToolTip="{l:T EditorRemoveMovesTip}"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="RemoveMoves_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Posiciones -->
                    <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T EditorPositions}" Style="{StaticResource GroupLabelStyle}" Margin="0,0,0,10" />
                            <Border Style="{StaticResource SegmentedContainerStyle}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="ScreenRadio" Content="{l:T EditorScreen}" GroupName="EditorPositions"
                                                 IsChecked="True" Style="{StaticResource CompactSegmentStyle}" Checked="Positions_Checked" />
                                    <RadioButton x:Name="RelativeRadio" Content="{l:T EditorRelativeShort}" GroupName="EditorPositions"
                                                 ToolTip="{l:T EditorRelativeTip}" Style="{StaticResource CompactSegmentStyle}"
                                                 Checked="Positions_Checked" />
                                </UniformGrid>
                            </Border>
                            <Button x:Name="WindowButton" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="PickWindow_Click">
                                <TextBlock x:Name="WindowText" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock x:Name="RelativeHintText" Text="{l:T EditorRelativeHint}" Style="{StaticResource RowHintStyle}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= Pie: estado + Cancelar / Guardar ================= -->
        <DockPanel Grid.Row="3" Margin="16,12,16,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="{l:T Cancel}" MinWidth="96" Style="{StaticResource SecondaryButtonStyle}"
                        Height="30" Click="Close_Click" />
                <Button x:Name="SaveButton" Content="{l:T Save}" MinWidth="96" Height="30" Margin="8,0,0,0"
                        Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
