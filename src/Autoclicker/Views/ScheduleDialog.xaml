<Window x:Class="Autoclicker.Views.ScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Autoclicker.Localization"
        Title="Programar"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Margin="14" Padding="18,16" Width="340" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource ToolTipBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.3" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Text="{l:T ScheduleStart}" Margin="0,14,0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Border Style="{StaticResource SegmentedContainerStyle}">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="NowRadio" Content="{l:T ScheduleNow}" GroupName="ScheduleMode"
                                 Style="{StaticResource CompactSegmentStyle}" Checked="Mode_Checked" />
                    <RadioButton x:Name="AtRadio" Content="{l:T ScheduleAt}" GroupName="ScheduleMode" IsChecked="True"
                                 Style="{StaticResource CompactSegmentStyle}" Checked="Mode_Checked" />
                    <RadioButton x:Name="InRadio" Content="{l:T ScheduleIn}" GroupName="ScheduleMode"
                                 Style="{StaticResource CompactSegmentStyle}" Checked="Mode_Checked" />
                </UniformGrid>
            </Border>

            <StackPanel x:Name="AtPanel" Orientation="Horizontal" Margin="0,10,0,0">
                <TextBox x:Name="HourBox" Text="03" MaxLength="2" Style="{StaticResource SmallFieldStyle}" Width="48"
                         TextChanged="Time_Changed" />
                <TextBlock Text=":" Margin="6,0" VerticalAlignment="Center" FontFamily="{StaticResource NumberFont}" FontSize="16" />
                <TextBox x:Name="MinuteBox" Text="00" MaxLength="2" Style="{StaticResource SmallFieldStyle}" Width="48"
                         TextChanged="Time_Changed" />
                <TextBlock x:Name="WhenText" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
            </StackPanel>

            <StackPanel x:Name="InPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBox x:Name="InBox" Text="30" MaxLength="4" Style="{StaticResource SmallFieldStyle}" />
                <TextBlock x:Name="InUnitText" Text="min" Style="{StaticResource UnitStyle}" />
            </StackPanel>

            <TextBlock Text="{l:T ScheduleEnd}" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button x:Name="EndButton" HorizontalContentAlignment="Stretch" Style="{StaticResource DropdownButtonStyle}"
                    Click="End_Click">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="EndText" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <TextBlock Text="{l:T ScheduleEndHint}" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="{l:T Cancel}" MinWidth="90" IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="{l:T ScheduleOk}" MinWidth="90" Margin="8,0,0,0" IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
