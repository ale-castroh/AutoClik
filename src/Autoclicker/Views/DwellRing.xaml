<Window x:Class="Autoclicker.Views.DwellRing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoClik"
        Width="44" Height="44" Left="-32000" Top="-32000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        IsHitTestVisible="False">

    <!-- Círculo del clic por permanencia (2.7): centrado en el cursor y traspasable; se llena hasta clicar. -->
    <Grid>
        <Ellipse Width="36" Height="36" StrokeThickness="4" Stroke="#66000000" />
        <Ellipse Width="36" Height="36" StrokeThickness="3" Stroke="#59FFFFFF" />
        <Ellipse x:Name="Arc" Width="36" Height="36" StrokeThickness="3" Stroke="{DynamicResource AccentBrush}"
                 StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform Angle="-90" />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</Window>
