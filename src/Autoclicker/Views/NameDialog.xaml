<Window x:Class="Autoclicker.Views.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Autoclicker.Localization"
        Title="Perfil"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Margin="14" Padding="18,16" Width="320" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource ToolTipBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.3" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Nuevo perfil" FontFamily="{StaticResource DisplayFont}"
                       FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="MessageText" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                       Style="{StaticResource CaptionStyle}" />

            <TextBox x:Name="NameBox" Margin="0,14,0,0" MaxLength="40" TextAlignment="Left"
                     Style="{StaticResource FieldStyle}" FontSize="13" FontFamily="{StaticResource UiFont}" />
            <TextBlock x:Name="ErrorText" Margin="2,6,0,0" Visibility="Collapsed" FontSize="12"
                       Foreground="#D13438" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="{l:T Cancel}" MinWidth="90" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="{l:T Save}" MinWidth="90" Margin="8,0,0,0" IsDefault="True"
                        Click="Ok_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border CornerRadius="6" Background="{DynamicResource AccentBrush}" />
                                            <Border x:Name="Hover" CornerRadius="6" Opacity="0" Background="#22FFFFFF" />
                                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
