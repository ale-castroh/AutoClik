<Window x:Class="Autoclicker.Views.KeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Autoclicker.Localization"
        Title="Atajo"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- Diálogo para asignar un atajo a una macro: pulsar una tecla o combinación (Esc cancela). -->
    <Border Margin="14" Padding="18,16" Width="320" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource ToolTipBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.3" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Atajo" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{l:T KeyDialogHint}" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" />

            <Border Margin="0,14,0,0" Height="44" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}">
                <TextBlock x:Name="KeyText" Text="" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{StaticResource NumberFont}" FontSize="18" />
            </Border>
            <TextBlock x:Name="ErrorText" Margin="2,6,0,0" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"
                       Foreground="#D13438" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="RemoveButton" Content="{l:T KeyDialogRemove}" MinWidth="90" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Remove_Click" Focusable="False" />
                <Button Content="{l:T Cancel}" MinWidth="90" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click" Focusable="False" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
