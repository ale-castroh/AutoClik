<Window x:Class="Autoclicker.Views.RegionPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Autoclicker.Localization"
        Title="Elegir zona"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="#40000000" Topmost="True" ShowInTaskbar="False"
        Cursor="Cross" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Canvas x:Name="Root">
        <!-- Rectángulo que se va dibujando al arrastrar -->
        <Rectangle x:Name="Box" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="#1AFFFFFF"
                   Visibility="Collapsed" IsHitTestVisible="False" />

        <Border x:Name="Label" Padding="12,8" CornerRadius="8" BorderThickness="1" IsHitTestVisible="False"
                Background="{DynamicResource ToolTipBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
            <StackPanel>
                <TextBlock x:Name="SizeText" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="HintText" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
